# Cloudinary credentials – copy this file to .env and fill in your values.
# Get these from: https://console.cloudinary.com → Settings → API Keys

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Cloudinary folder prefix (default: birthday_phone)
# CLOUDINARY_FOLDER=birthday_phone
